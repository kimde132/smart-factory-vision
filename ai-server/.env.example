# ─────────────────────────────────────────────────────────────
# .env 견본 파일
#
# 이 파일은 무엇을 하는가:
#   실제 접속 정보가 담긴 .env 파일에 "어떤 항목이 필요한지"를 알려주는 견본이다.
#   .env 는 .gitignore 로 제외되어 git 에 올라가지 않으므로,
#   다른 PC 에서 받았을 때 무엇을 채워야 하는지 알 방법이 이 파일뿐이다.
#
# 사용법:
#   이 파일을 같은 폴더에 .env 라는 이름으로 복사한 뒤 값을 채운다.
#   .env 에는 실제 비밀번호가 들어가므로 절대 커밋하지 않는다.
#
# 실행 흐름에서의 위치:
#   ai-server 가 시작될 때 python-dotenv 가 .env 를 읽어 환경변수로 올린다.
#   코드에는 접속 정보를 절대 하드코딩하지 않는다.
# ─────────────────────────────────────────────────────────────

# --- SQL Server 접속 정보 ---

# 서버 주소. 기본 인스턴스(MSSQLSERVER)로 설치했으므로 localhost 로 접속한다.
# 명명된 인스턴스였다면 localhost\INSTANCENAME 형태가 된다.
MSSQL_SERVER=localhost

# TCP 포트. 기본 인스턴스의 기본값은 1433.
MSSQL_PORT=1433

# 이 프로젝트가 사용할 데이터베이스 이름
MSSQL_DATABASE=

# 로그인 계정. sa(최고 권한 계정)를 그대로 쓰지 않고
# 이 프로젝트 전용 로그인을 따로 만들어 쓴다.
MSSQL_USER=
MSSQL_PASSWORD=

# --- ODBC 드라이버 설정 ---

# pyodbc 가 사용할 드라이버 이름. 설치된 이름과 글자 하나까지 같아야 한다.
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# ODBC Driver 18 부터는 암호화가 기본으로 켜져 있다(Encrypt=yes).
MSSQL_ENCRYPT=yes

# 로컬 SQL Server 는 자체 서명 인증서를 쓰기 때문에
# 이 값을 yes 로 두지 않으면 SSL 신뢰 오류로 접속이 거부된다.
# 개발 환경에서만 yes 로 둔다.
MSSQL_TRUST_SERVER_CERTIFICATE=yes
