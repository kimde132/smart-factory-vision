# ─────────────────────────────────────────────────────────────
# 데이터 · 모델 — git에 절대 올리지 않는다
# 용량이 크고 한 번 커밋되면 히스토리에서 제거하기 어렵다.
# 데이터셋은 Google Drive, 모델 가중치는 Colab 산출물로 관리한다.
# ─────────────────────────────────────────────────────────────
dataset/
datasets/
models/
storage/
runs/

# 확장자 안전망 — 위 폴더 규칙을 벗어난 위치에 생겨도 잡히도록
*.pt
*.onnx
*.engine
*.jpg
*.jpeg
*.png
*.bmp
*.mp4
*.avi

# 단, 문서용 스크린샷은 여기에만 두고 예외로 추적한다
!docs/images/
!docs/images/**

# ─────────────────────────────────────────────────────────────
# 비밀 정보 — DB 접속 정보는 코드가 아니라 .env에만 둔다
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# 라벨링 도구가 프로젝트 안에 데이터 디렉터리를 만들 경우
label-studio-data/

# ─────────────────────────────────────────────────────────────
# C# / .NET / WPF
# bin·obj는 빌드 산출물이라 소스에서 언제든 다시 만들어진다
# ─────────────────────────────────────────────────────────────
bin/
obj/
.vs/
*.user
*.suo

# ─────────────────────────────────────────────────────────────
# 에디터 · OS
# ─────────────────────────────────────────────────────────────
.idea/
*.log
Thumbs.db
desktop.ini
